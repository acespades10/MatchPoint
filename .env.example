# ─── OJT Scout — Environment Variables ───────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real keys.

# ─── OpenAI (Phases 1, 3, 4, 5, 6) ───────────────────────────────
OPENAI_API_KEY=sk-...
# Optional — only set if your account requires it
OPENAI_ORG_ID=

# Any supported provider (optional; overrides the legacy OpenAI key above).
# Providers: openai, anthropic, gemini, openrouter, groq, deepseek, mistral,
# xai, codex, custom. Use the model ID listed by your selected provider.
# AI_PROVIDER=anthropic
# AI_API_KEY=your-provider-key
# AI_MODEL=your-provider-model-id
# AI_BASE_URL=https://api.anthropic.com/v1
# Custom endpoints only: chat, responses, anthropic, or gemini
# AI_API_TYPE=anthropic

# ─── App Config ──────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# Path to the local IALAP company data (built by scripts/extractIALAP.js)
COMPANIES_DATA_PATH=./data/companies.json

# ─── Pipeline Tuning ─────────────────────────────────────────────
ENRICHMENT_CACHE_TTL_DAYS=30
MAX_CONCURRENT_ENRICHMENTS=5
VECTOR_TOP_N=30

# NOTE: Google Sheets API is intentionally NOT used in this demo build.
# Company data is loaded from the local JSON file above.
